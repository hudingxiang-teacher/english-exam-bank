# 中考英语题库 - 环境变量示例
# 复制为 .env 后填入实际值

# 数据库连接（不填则使用本地 SQLite data/exam.db）
# 阿里云/腾讯云 PostgreSQL 示例：
#   DATABASE_URL=postgresql://用户名:密码@内网IP:5432/exam_bank
# Render PostgreSQL 示例：
#   DATABASE_URL=postgresql://exam_bank_xxx:密码@dpg-xxx/exam_bank
DATABASE_URL=

# Flask SECRET_KEY（生产环境必须改成随机字符串）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# 服务监听端口（云平台一般用环境变量 PORT）
PORT=5000
